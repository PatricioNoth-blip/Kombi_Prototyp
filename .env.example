# Kopieren nach .env und ausfüllen. Werte: Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
# „Publishable key“ (sb_publishable_…) oder bei älteren Projekten der „anon public“-Key.
# Der Schlüssel ist öffentlich – geschützt wird über den WG-Login und die Datenbankrechte.
VITE_SUPABASE_KEY=
